# Foundry / Agent Framework configuration
FOUNDRY_PROJECT_ENDPOINT=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Model deployments from the lab
SMALL_MODEL_DEPLOYMENT=gpt-4o-mini
LARGE_MODEL_DEPLOYMENT=gpt-4o

# Foundry IQ / Knowledge setup
# Upload the files in ../data to Foundry IQ or Foundry Agent knowledge before running live agents.
FOUNDRY_IQ_KNOWLEDGE_BASE_ID=
FOUNDRY_IQ_KNOWLEDGE_BASE_NAME=contoso-retail-lab

# Foundry tool names or IDs used by the pro-code agents.
# In a real project, these would front operational systems, not repo CSV files.
ORDER_LOOKUP_TOOL_NAME=contoso-order-lookup
HISTORY_SEARCH_TOOL_NAME=contoso-ticket-history-search

# Local seed-data paths, relative to pro-code/. These are for upload/setup guidance only.
# Runtime agent lookups should go through Foundry IQ and Foundry tools.
DATA_DIR=../data
PROMPTS_DIR=prompts
